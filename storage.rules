rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    match /competencies/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.resource.size < 15 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf')
      );
    }

    match /company_documents/{companyId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.resource.size < 15 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf')
      );
    }

    match /project_documents/{projectId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.resource.size < 25 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('.*document.*'))
      );
    }

    match /project_quotes/{projectId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.resource.size < 25 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf')
      );
    }

    match /project_photos/{projectId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*')
      );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
